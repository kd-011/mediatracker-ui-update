+    avg = diary.filter(score__isnull=False).aggregate(a=Avg("score"))["a"]
+    return {
+        "movies": diary.filter(
+            episode_from__isnull=True, episode_to__isnull=True
+        ).count(),
+        "episodes": spans.aggregate(
+            n=Sum(F("episode_to") - F("episode_from") + 1, output_field=IntegerField())
